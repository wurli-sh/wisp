{
  "name": "@amoeba_/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for proving, settling, and auditing Amoeba compliant transfers on Stellar",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wurli-sh/amoeba.git",
    "directory": "sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "default": "./dist/demo/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/sdk.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@amoeba_/bindings": "workspace:*",
    "@amoeba_/compliance": "workspace:*",
    "@amoeba_/js": "workspace:*",
    "@amoeba_/verifier": "workspace:*",
    "@stellar/stellar-sdk": "^14.5.0",
    "ajv": "^8.17.1",
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
