{
  "name": "@wisp_/sdk",
  "version": "0.2.1",
  "description": "TypeScript SDK for proving, settling, and auditing Wisp compliant transfers on Stellar",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wurli-sh/wisp.git",
    "directory": "sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./flows": {
      "types": "./dist/flows.d.ts",
      "default": "./dist/flows.js"
    },
    "./demo": {
      "types": "./dist/demo/index.d.ts",
      "default": "./dist/demo/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/sdk.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@wisp_/bindings": "workspace:*",
    "@wisp_/client": "workspace:*",
    "@wisp_/core": "workspace:*",
    "@wisp_/demo": "workspace:*",
    "@wisp_/flows": "workspace:*",
    "@wisp_/compliance": "workspace:*",
    "@wisp_/js": "workspace:*",
    "@wisp_/verifier": "workspace:*",
    "@stellar/stellar-sdk": "^14.5.0",
    "ajv": "^8.17.1",
    "snarkjs": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
