{
  "name": "wisp",
  "private": true,
  "scripts": {
    "compile:circuit": "cd circuits/circom && ./scripts/compile.sh",
    "setup:circuit": "cd circuits/circom && ./scripts/setup.sh",
    "build:js": "pnpm --filter @wisp_/compliance exec tsc && pnpm --filter @wisp_/verifier exec tsc && pnpm --filter @wisp_/js run build && pnpm --filter @wisp_/bindings run build && pnpm --filter @wisp_/sdk run build && pnpm --filter @wisp_/issuer-sdk run build",
    "gen:bindings": "node --import tsx bindings/scripts/generate.ts",
    "gen:crypto-fixtures": "node --import tsx bindings/scripts/gen-crypto-fixtures.ts && node --import tsx bindings/scripts/gen-addresses.ts",
    "gen:fixtures": "node --import tsx circuits/circom/scripts/gen-fixture.ts",
    "gen:testnet-fixture": "node --import tsx scripts/dev/gen-testnet-fixture.ts",
    "build:bindings-clients": "pnpm --filter @wisp_/compliance exec tsc && pnpm --filter @wisp_/verifier exec tsc",
    "test:js": "pnpm --filter @wisp_/js run test && pnpm --filter @wisp_/sdk run test && pnpm --filter @wisp_/issuer-sdk run test && pnpm test:bindings",
    "test:witness": "pnpm --filter @wisp_/js run test",
    "test:sdk": "pnpm --filter @wisp_/sdk run test",
    "test:issuer-sdk": "pnpm --filter @wisp_/issuer-sdk run test",
    "verify:phase3-blockers": "./scripts/dev/verify-phase3-blockers.sh",
    "demo:phase3": "./scripts/dev/demo-phase3.sh",
    "demo:phase4": "./scripts/dev/demo-phase4.sh",
    "dev:frontend": "pnpm --filter @wisp_/web dev",
    "build:frontend": "pnpm --filter @wisp_/web build",
    "test:e2e:frontend": "pnpm --filter @wisp_/web run test:e2e",
    "prove": "cd circuits/circom && ./scripts/prove.sh",
    "verify": "cd circuits/circom && ./scripts/verify-local.sh",
    "test:circuit": "node --import tsx --test circuits/circom/test/*.test.ts",
    "test:bindings": "node --import tsx --test bindings/test/public-inputs.test.ts bindings/test/circuit-abi.test.ts bindings/test/proof-package-schema.test.ts",
    "test:issuer-conformance": "node --import tsx scripts/dev/issuer-conformance.ts",
    "ceremony:init": "cd circuits/circom && ./scripts/ceremony-init.sh",
    "ceremony:verify": "cd circuits/circom && ./scripts/ceremony-verify.sh",
    "ceremony:sync": "cd circuits/circom && ./scripts/sync-verifier-from-ceremony.sh",
    "ceremony:publish": "cd circuits/circom && ./scripts/ceremony-publish.sh",
    "test:ceremony": "./circuits/circom/test/ceremony-gates.test.sh"
  },
  "devDependencies": {
    "@wisp_/issuer-sdk": "workspace:*",
    "@wisp_/sdk": "workspace:*",
    "snarkjs": "^0.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
