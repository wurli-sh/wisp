{
  "name": "@wisp_/bindings",
  "version": "0.3.0",
  "description": "Canonical Wisp ABI bindings — public inputs, proof package types, contract metadata",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wurli-sh/wisp.git",
    "directory": "bindings"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./publicInputs": {
      "types": "./dist/publicInputs.d.ts",
      "default": "./dist/publicInputs.js"
    },
    "./proofPackage": {
      "types": "./dist/proofPackage.d.ts",
      "default": "./dist/proofPackage.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@wisp_/js": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
