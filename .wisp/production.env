# Shared production URLs + on-chain IDs (Wisp contracts + hosted services).
# Copy into Render dashboard (issuer) and Vercel dashboard (frontend VITE_*).
# Secrets (ISSUER_API_TOKEN, ISSUER_SECRET_KEY, SUPABASE_DB_URL) stay in host dashboards only.

# --- Stellar testnet (from .wisp/compliance.env + sac.env + testnet-demo.env) ---
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015
VERIFIER_CONTRACT_ID=CBOQVGV7SIFNBDM26GFFAHWQ6DKUBAX4K2OR44KEWJJCYQH4SJL3G2AG
COMPLIANCE_CONTRACT_ID=CBN7EJWN6BDGBAKT3MMSHLMTXCKDLXRSPD2XMQYSR3KWCUBRU5PT5CH4
SAC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
EXPECTED_VK_HASH=3325bfff94f2c530d199c35575dc45cd3e27f752d9402d17e6d64341d3f3f6ae
COMPLIANCE_DEPLOY_LEDGER=3188535
ISSUER_PUBLIC_KEY=GA2R4CVM7W2R62S7ZXTPPMSPAUPSSHAS2VRI4BHUPALAQGQDQLVDY7BX

# --- Wisp deployment targets ---
FRONTEND_URL=https://wisp-zk.vercel.app
ISSUER_URL=https://wisp-issuer-vekn.onrender.com
ISSUER_PUBLIC_URL=https://wisp-issuer-vekn.onrender.com
WEB_AUTH_DOMAIN=wisp-issuer-vekn.onrender.com

# --- Wisp runtime (issuer + SDK) ---
WISP_ENV=production
WISP_FIXTURE_PROFILE=testnet
WISP_FIXTURES_DIR=/app/bindings/fixtures
ISSUER_REQUIRE_DB=1
KYC_MODE=sep10

