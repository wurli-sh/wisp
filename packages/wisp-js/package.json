{
  "name": "@amoeba_/js",
  "version": "0.1.0",
  "description": "Amoeba cryptographic primitives — Poseidon2, Merkle trees, nullifiers, witness builder",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wurli-sh/amoeba.git",
    "directory": "packages/amoeba-js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./witness": {
      "types": "./dist/witness.d.ts",
      "default": "./dist/witness.js"
    },
    "./strkey": {
      "types": "./dist/strkey.d.ts",
      "default": "./dist/strkey.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/witness.test.ts src/publicInputs.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "ffjavascript": "^0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
