PUBLISH_SOURCE_ACCOUNT=amoeba-admin
ADMIN_PUBLIC_KEY=
# Optional raw S-key secrets (only if not using SOURCE identity above):
ADMIN_SECRET_KEY=
ISSUER_SECRET_KEY=

# ── Phase 3 fixture profile ───────────────────────────────
# local (default) | testnet
# WISP_FIXTURE_PROFILE=local

# ── Issuer Service ───────────────────────────────────────
ISSUER_LISTEN_ADDR=127.0.0.1:3000
ISSUER_STATE_PATH=.wisp/issuer-state.json
ISSUER_API_TOKEN=demo-token
ISSUER_PUBLIC_KEY=
PROVIDER_WEBHOOK_SECRETS=persona=replace-me,sumsub=replace-me

# ── Issuer persistence (pick one) ────────────────────────
# Postgres (preferred for shared/testnet): mock KYC survives issuer restarts.
# Local / direct (IPv6): db.<ref>.supabase.co
# SUPABASE_DB_URL=postgresql://postgres:<DB_PASSWORD>@db.jbayfhlzsqviypspfjpc.supabase.co:5432/postgres?sslmode=require
# Render / cloud (use Session pooler — direct host is IPv6-only and fails on Render):
# SUPABASE_DB_URL=postgresql://postgres.jbayfhlzsqviypspfjpc:<DB_PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Copy exact URI from Supabase → Connect → Session pooler → URI.
# DATABASE_URL is an alias for SUPABASE_DB_URL (used by Render and other hosts).
# Migrations: ./scripts/deploy/migrate-issuer-db.sh
# Production: set ISSUER_REQUIRE_DB=1 or WISP_ENV=production to fail fast if DB is unreachable.
# Local file snapshot (default via ISSUER_STATE_PATH when Postgres is unset).
# Project: amoeba | ref: jbayfhlzsqviypspfjpc | region: ap-southeast-1
SUPABASE_URL=https://jbayfhlzsqviypspfjpc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

