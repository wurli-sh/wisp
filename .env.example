# ── Network ──────────────────────────────────────────────
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contracts (fill after deployment) ────────────────────
VERIFIER_CONTRACT_ID=CAUPSWAQLEK5UH63LSCTH4HELV6IIELGMRVHU4NTBEYQ7AOX2MHRTYUJ
COMPLIANCE_CONTRACT_ID=
SAC_CONTRACT_ID=

# ── Keys ─────────────────────────────────────────────────
# Generate with: stellar keys generate --network testnet
# Root publish uses a Stellar CLI identity name by default (matches deploy scripts).
SOURCE=amoeba-admin
PUBLISH_SOURCE_ACCOUNT=amoeba-admin
ADMIN_PUBLIC_KEY=
# Optional raw S-key secrets (only if not using SOURCE identity above):
ADMIN_SECRET_KEY=
ISSUER_SECRET_KEY=

# ── Phase 3 fixture profile ───────────────────────────────
# local (default) | testnet
# AMOEBA_FIXTURE_PROFILE=local

# ── Issuer Service ───────────────────────────────────────
ISSUER_LISTEN_ADDR=127.0.0.1:3000
ISSUER_STATE_PATH=.amoeba/issuer-state.json
ISSUER_API_TOKEN=demo-token
ISSUER_PUBLIC_KEY=

# ── Mainnet ceremony (required for NETWORK=mainnet deploy) ─
# AMOEBA_MAINNET_APPROVED=1
# CEREMONY_DIR=circuits/circom/artifacts/ceremony
# CEREMONY_FINAL_ZKEY=circuits/circom/artifacts/ceremony/compliance_corridor_final.zkey
